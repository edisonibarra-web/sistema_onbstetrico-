# Copiar este archivo a ".env" (sin versionar) y completar con los valores reales.
# Nunca commitear el archivo ".env" real.

# Clave secreta de Django. Generar una nueva para cada entorno, no reusar la de desarrollo.
DJANGO_SECRET_KEY=

# "True" solo en desarrollo local. En cualquier entorno compartido/producción debe ser "False".
DJANGO_DEBUG=False

# "True" exige inicio de sesión en todo el sistema. Poner en "False" únicamente si esta app
# se está integrando temporalmente detrás de otra aplicación que ya controla el login.
REQUIRE_LOGIN=True

# Credenciales de la base de datos externa de solo lectura DGEMPRES_NEXUS (sistema hospitalario).
# Solicitar al DBA/IT del hospital; nunca hardcodear estos valores en settings.py.
DGEMPRES_NEXUS_USER=
DGEMPRES_NEXUS_PASSWORD=
DGEMPRES_NEXUS_HOST=
