# Copiar este archivo a ".env" (sin versionar) y completar con los valores reales.
# Nunca commitear el archivo ".env" real.

# Clave secreta de Django. Generar una nueva para cada entorno, no reusar la de desarrollo.
DJANGO_SECRET_KEY=

# "True" solo en desarrollo local. En cualquier entorno compartido/producción debe ser "False".
DJANGO_DEBUG=False

# "True" exige inicio de sesión en todo el sistema. Poner en "False" únicamente si esta app
# se está integrando temporalmente detrás de otra aplicación que ya controla el login.
REQUIRE_LOGIN=True

# Credenciales de la base de datos externa de solo lectura de Dinámica (sistema
# hospitalario). Solicitar al DBA/IT del hospital; nunca hardcodear en settings.py.
#
# NAME y PORT son opcionales: si se dejan vacíos, caen en "DGEMPRES_NEXUS" y
# "1433" (la base de producción de siempre, en el puerto estándar). Se agregaron
# para poder apuntar TEMPORALMENTE a la base de pruebas de Dinámica (mientras se
# valida un campo nuevo con la jefe de sala de partos, por ejemplo) sin tocar
# código — solo cambiar estos 5 valores y, cuando termine la prueba, volver a
# ponerlos como estaban (o borrar NAME/PORT para que vuelvan a su default).
DGEMPRES_NEXUS_USER=
DGEMPRES_NEXUS_PASSWORD=
DGEMPRES_NEXUS_HOST=
DGEMPRES_NEXUS_NAME=
DGEMPRES_NEXUS_PORT=

# Base de datos LOCAL ("unificada_partos"). Dejar todo esto vacío para correr
# fuera de Docker (`runserver` nativo en Windows): usa por defecto
# localhost\SQLEXPRESS con autenticación de Windows, igual que siempre.
#
# Para correr dentro de Docker SÍ hay que llenar las 4 variables (Windows
# Auth no existe en Linux y "localhost" dentro del contenedor no es esta
# máquina). Requiere antes habilitar TCP/IP + puerto fijo + modo mixto en la
# instancia SQLEXPRESS (SQL Server Configuration Manager) y crear un login
# SQL con permisos sobre unificada_partos:
#   DB_LOCAL_HOST=host.docker.internal
#   DB_LOCAL_PORT=<puerto TCP fijo que le hayas asignado a SQLEXPRESS>
#   DB_LOCAL_USER=<login SQL>
#   DB_LOCAL_PASSWORD=<password de ese login>
DB_LOCAL_NAME=
DB_LOCAL_HOST=
DB_LOCAL_PORT=
DB_LOCAL_USER=
DB_LOCAL_PASSWORD=
